<?xml version="1.0" encoding="UTF-8"?>
<!-- JavaFX layout file -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.MenuBar?>
<BorderPane fx:id="mainBorderPane" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.dirchat.controller.UIController">
    <top>
        <MenuBar/>
        <VBox spacing="5">
            <HBox prefHeight="6.0" prefWidth="501.0" spacing="10">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
                <Button fx:id="loadFolderButton" text="📁 Load Folder">
                    <tooltip>
                        <Tooltip text="Load a folder of documents" />
                    </tooltip>
                </Button>
                <Label fx:id="folderLabel" style="-fx-font-size: 11; -fx-text-fill: #555;" text="No folder selected" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="configButton" text="⚙️ Config">
                    <tooltip>
                        <Tooltip text="Open configuration" />
                    </tooltip>
                </Button>
            </HBox>
            <HBox spacing="8">
                <ProgressBar fx:id="folderProgressBar" prefHeight="12.0" prefWidth="420.0" progress="0.0" />
                <Label fx:id="indexLoadedIndicator" text="✅" style="-fx-font-size: 18; -fx-text-fill: green;" visible="false">
                    <tooltip>
                        <Tooltip text="Index loaded!" />
                    </tooltip>
                </Label>
            </HBox>
        </VBox>
    </top>
    <center>
        <VBox spacing="5">
            <HBox prefHeight="6.0" prefWidth="501.0" spacing="10">
             <TextField fx:id="questionField" prefHeight="25.0" prefWidth="350.0" promptText="Type your question here..." />
             <Button fx:id="askButton" text="💬 Ask">
                <tooltip>
                    <Tooltip text="Ask a question" />
                </tooltip>
             </Button>
            </HBox>
            <ListView fx:id="chatListView" prefHeight="180" />
            <ListView fx:id="indexStatusList" prefHeight="220" />
        </VBox>
    </center>
    <bottom>
        <HBox spacing="5" style="-fx-background-color: #f0f0f0;">
            <Label fx:id="messageBar" style="-fx-font-size: 12; -fx-text-fill: #333;" text="" />
        </HBox>
    </bottom>
</BorderPane>
