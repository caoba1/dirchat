<?xml version="1.0" encoding="UTF-8"?>
<!-- JavaFX layout file -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.MenuBar?>
<BorderPane fx:id="mainBorderPane" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.dirchat.controller.UIController">
    <top>
        <MenuBar/>
        <VBox spacing="5">
            <HBox prefHeight="6.0" prefWidth="501.0" spacing="10">
                <padding>
                    <Insets bottom="10" left="10" right="10" top="10" />
                </padding>
                <Button fx:id="loadFolderButton" text="📁 Load Folder" />
                <Label fx:id="folderLabel" style="-fx-font-size: 11; -fx-text-fill: #555;" text="No folder selected" />
                <Button fx:id="configButton" text="⚙️ Config" />
            </HBox>
            <ProgressBar fx:id="folderProgressBar" prefHeight="6.0" prefWidth="501.0" progress="0.0" />
            <ProgressBar fx:id="progressBar" prefHeight="6.0" prefWidth="501.0" progress="0.0" />
        </VBox>
    </top>
    <center>
        <VBox spacing="5">
            <HBox prefHeight="6.0" prefWidth="501.0" spacing="10">
             <TextField fx:id="questionField" prefHeight="25.0" prefWidth="459.0" promptText="Type your question here..." />
             <Button fx:id="askButton" text="💬 Ask" />
            </HBox>
            <ListView fx:id="chatListView" prefHeight="300" />
            <ListView fx:id="indexStatusList" prefHeight="100" />
        </VBox>
    </center>
    <bottom>
        <HBox spacing="5" style="-fx-background-color: #f0f0f0;">
            <Label fx:id="messageBar" style="-fx-font-size: 12; -fx-text-fill: #333;" text="" />
        </HBox>
    </bottom>
</BorderPane>
